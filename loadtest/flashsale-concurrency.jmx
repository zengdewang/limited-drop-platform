def allowedHttp = scenario.startsWith(&apos;limit-&apos;) ? [&apos;200&apos;, &apos;429&apos;] : [&apos;200&apos;]
if (!allowedHttp.contains(http)) increment(&apos;http_error&apos;)

try {
    def body = new JsonSlurper().parseText(prev.getResponseDataAsString())
    if (http == &apos;429&apos; || (body.code instanceof Number &amp;&amp; body.code.intValue() == 429)) {
        increment(&apos;rate_limited&apos;)
    } else if (http == &apos;200&apos; &amp;&amp; body.code instanceof Number &amp;&amp; body.code.intValue() == 0 &amp;&amp; body.data instanceof Map) {
        def businessCode = body.data.code
        if (!(businessCode instanceof Number)) {
            increment(&apos;invalid_business&apos;)
        } else {
            switch (businessCode.intValue()) {
                case 0:
                    increment(&apos;success&apos;)
                    if (!(body.data.remaining instanceof Number) || body.data.remaining.longValue() &lt; 0) increment(&apos;oversell&apos;)
                    if (body.data.orderNo) props.get(&apos;flashsale.orderNos&apos;).add(body.data.orderNo.toString())
                    break
