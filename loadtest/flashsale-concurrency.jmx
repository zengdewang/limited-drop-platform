              <stringProp name="parameters"></stringProp>
              <stringProp name="script">
def scenario = vars.get(&apos;scenario&apos;)
if (scenario == &apos;limit-ip&apos;) {
    vars.put(&apos;effective_token&apos;, vars.get(&apos;token&apos;) ?: &apos;&apos;)
    vars.put(&apos;effective_ip&apos;, props.getProperty(&apos;limit_ip&apos;, &apos;198.51.100.10&apos;))
} else {
    vars.put(&apos;effective_token&apos;, props.getProperty(&apos;same_user_token&apos;, &apos;&apos;))
    int octet = (ctx.getThreadNum() % 250) + 1
    vars.put(&apos;effective_ip&apos;, &quot;198.51.100.${octet}&quot;)
}
