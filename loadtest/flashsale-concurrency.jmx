      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="输出成功、售罄、重复、限流与超卖统计" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">
import groovy.json.JsonOutput
import java.util.concurrent.atomic.AtomicLong

def value = { name -&gt;
    def counter = props.get(&quot;flashsale.counter.${name}&quot;)
    counter instanceof AtomicLong ? counter.get() : 0L
}
def scenario = props.getProperty(&apos;flashsale.scenario&apos;, props.getProperty(&apos;scenario&apos;, &apos;inventory&apos;))
def expected = props.getProperty(&apos;flashsale.expectedSamples&apos;, &apos;0&apos;) as long
def stock = props.getProperty(&apos;stock&apos;, &apos;0&apos;) as long
def samples = value(&apos;samples&apos;)
def success = value(&apos;success&apos;)
def soldout = value(&apos;soldout&apos;)
def duplicate = value(&apos;duplicate&apos;)
def unopened = value(&apos;unopened&apos;)
def rateLimited = value(&apos;rate_limited&apos;)
def httpError = value(&apos;http_error&apos;)
def invalidJson = value(&apos;invalid_json&apos;)
def invalidBusiness = value(&apos;invalid_business&apos;)
def oversell = value(&apos;oversell&apos;)
def assertionFailures = value(&apos;assertion_failures&apos;)
def orderNos = props.get(&apos;flashsale.orderNos&apos;)
def latencies = (props.get(&apos;flashsale.latencies&apos;) ?: []).collect { it as long }.sort()
def averageMs = latencies.isEmpty() ? 0 : Math.round((latencies.sum() / (double) latencies.size()) * 100) / 100.0
def p95Ms = latencies.isEmpty() ? 0 : latencies[Math.max(0, (int) Math.ceil(latencies.size() * 0.95) - 1)]

def failures = []
def configError = props.getProperty(&apos;flashsale.configError&apos;)
if (configError) failures &lt;&lt; configError
if (samples != expected) failures &lt;&lt; &quot;样本数不符：expected=${expected}, actual=${samples}&quot;
if (httpError &gt; 0) failures &lt;&lt; &quot;非预期 HTTP 状态=${httpError}&quot;
if (invalidJson &gt; 0) failures &lt;&lt; &quot;非法 JSON=${invalidJson}&quot;
if (invalidBusiness &gt; 0) failures &lt;&lt; &quot;非法业务响应=${invalidBusiness}&quot;
if (assertionFailures &gt; 0) failures &lt;&lt; &quot;断言失败=${assertionFailures}&quot;
if (oversell &gt; 0) failures &lt;&lt; &quot;发现 remaining&lt;0 的超卖响应=${oversell}&quot;

if (scenario == &apos;inventory&apos; || scenario == &apos;ramp&apos;) {
    long expectedSuccess = Math.min(stock, samples)
    if (success != expectedSuccess) failures &lt;&lt; &quot;成功数应为 min(stock,samples)=${expectedSuccess}，实际=${success}&quot;
    if (success &gt; stock) failures &lt;&lt; &quot;成功数 ${success} 超过库存 ${stock}&quot;
    if (success + soldout != samples) failures &lt;&lt; &apos;不同用户结果应全部为成功或售罄&apos;
    if (duplicate &gt; 0) failures &lt;&lt; &quot;不同用户场景出现重复购买=${duplicate}&quot;
    if (unopened &gt; 0) failures &lt;&lt; &quot;出现未开售响应=${unopened}&quot;
}
if (scenario == &apos;same-user&apos;) {
    if (success != 1) failures &lt;&lt; &quot;同用户场景必须且只能成功 1 次，实际=${success}&quot;
    if (duplicate != Math.max(0, samples - 1)) failures &lt;&lt; &quot;其余请求应全部重复，duplicate=${duplicate}&quot;
    if (orderNos == null || orderNos.size() != 1) failures &lt;&lt; &quot;成功与重复响应必须使用同一 orderNo，唯一值数量=${orderNos?.size() ?: 0}&quot;
    if (soldout &gt; 0 || unopened &gt; 0 || rateLimited &gt; 0) failures &lt;&lt; &apos;同用户直连场景不应出现售罄、未开售或限流&apos;
}
if (scenario.startsWith(&apos;limit-&apos;) &amp;&amp; rateLimited &lt; 1) {
    failures &lt;&lt; &apos;未观察到 HTTP 429，请检查线程数与 Gateway 限流阈值&apos;
}

def summary = [
    scenario: scenario,
    checks: failures.isEmpty() ? &apos;PASS&apos; : &apos;FAIL&apos;,
    expected_samples: expected,
    samples: samples,
    success: success,
    soldout: soldout,
    duplicate: duplicate,
    unopened: unopened,
    rate_limited: rateLimited,
    http_error: httpError,
    invalid_json: invalidJson,
    invalid_business: invalidBusiness,
    oversell: oversell,
    assertion_failures: assertionFailures,
    unique_order_nos: orderNos?.size() ?: 0,
    average_ms: averageMs,
    p95_ms: p95Ms,
    failures: failures
]
def json = JsonOutput.prettyPrint(JsonOutput.toJson(summary))
SampleResult.setResponseData(json, &apos;UTF-8&apos;)
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setResponseCode(failures.isEmpty() ? &apos;200&apos; : &apos;500&apos;)
SampleResult.setResponseMessage(failures.isEmpty() ? &apos;PASS&apos; : &apos;FAIL&apos;)
SampleResult.setSuccessful(failures.isEmpty())
log.info(&apos;FLASHSALE_SUMMARY &apos; + JsonOutput.toJson(summary))

def summaryPath = props.getProperty(&apos;summary_file&apos;, &apos;&apos;)
if (summaryPath) {
    def file = new File(summaryPath)
    file.parentFile?.mkdirs()
    file.setText(json, &apos;UTF-8&apos;)
}
          </stringProp>
